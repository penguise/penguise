.lobby-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 36px 24px 24px 24px;
}

/* One ice slab holding every section. */
.lobby-panel {
    width: 100%;
    max-width: 720px;
    max-height: 900px;
    min-height: 0;
    flex-grow: 1;
    padding: 30px 14px 14px 14px;
}

.lobby-card {
    padding: 12px 14px;
}

.room-info {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-shrink: 0;
}

.room-name {
    flex-grow: 1;
    width: 240px;
    min-width: 0;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    margin: 4px 12px 4px 0;
}

.room-code-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    width: 320px;
    max-width: 100%;
    min-width: 0;
}

.room-code {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    margin: 4px 8px 4px 0;
}

.lobby-control {
    flex-shrink: 0;
    font-size: 16px;
}

.copy-code-button {
    min-width: 104px;
    margin: 0;
}

.profile-card {
    flex-shrink: 0;
    margin-top: 12px;
}

.profile-name-row {
    flex-direction: row;
    align-items: center;
    height: 48px;
}

.player-name-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 16px;
    margin: 0 8px 0 0;
}

.player-name-input > .unity-base-field__label {
    min-width: 56px;
}

.save-name-button {
    min-width: 100px;
    margin: 0;
}

.color-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 10px;
}

.color-picker {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Snow tile per color; the penguin badge wears the color. */
.color-option {
    width: 23%;
    flex-grow: 1;
    min-height: 60px;
    align-items: center;
    justify-content: center;
    color: rgb(29, 59, 92);
    background-color: white;
    border-width: 3px;
    border-bottom-width: 5px;
    border-color: rgb(150, 198, 228);
    border-radius: 12px;
    margin: 6px 6px 0 0;
    padding: 4px;
    font-size: 14px;
    -unity-font-style: bold;
}

.color-option:hover:enabled { background-color: white; border-color: rgb(43, 93, 138); }
.color-option:focus:enabled { border-color: rgb(43, 93, 138); }
.color-option:active:enabled { background-color: rgb(227, 244, 252); }
.color-selected,
.color-selected:hover:enabled,
.color-selected:focus:enabled { border-color: rgb(245, 154, 35); background-color: rgb(255, 243, 220); }
.color-taken { opacity: 0.5; }
.color-state { font-size: 12px; -unity-font-style: normal; color: rgb(62, 108, 146); }
.color-heading { flex-direction: row; align-items: center; }

/* Drawn by PenguinBadge in the player color. */
.color-avatar {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin-right: 6px;
}

.profile-status {
    color: rgb(166, 92, 10);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 8px;
}

.players-card {
    flex-grow: 1;
    min-height: 0;
    margin-top: 12px;
}

.players-title {
    flex-shrink: 0;
    align-self: flex-start;
    font-size: 18px;
    padding: 4px 16px 5px 16px;
    margin: 0 0 12px 0;
}

.player-list {
    flex-grow: 1;
    min-height: 0;
}

/* Snow bubble per player. */
.player-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 50px;
    padding: 6px 12px;
    margin-bottom: 8px;
    background-color: white;
    border-width: 0;
    border-bottom-width: 3px;
    border-color: rgb(150, 198, 228);
    border-radius: 12px;
}

.player-row-self {
    background-color: rgb(255, 243, 220);
    border-color: rgb(245, 154, 35);
}

.player-avatar {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    margin-right: 10px;
}

.player-name {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.player-badge {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 3px 10px;
    margin-left: 8px;
    background-color: rgb(43, 93, 138);
    border-radius: 10px;
}

.start-requirement {
    flex-shrink: 0;
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 12px;
}

.lobby-status {
    flex-shrink: 0;
    color: rgb(190, 40, 40);
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 12px;
}

.lobby-hidden {
    display: none;
}

.lobby-actions {
    flex-direction: row;
    flex-shrink: 0;
    height: 48px;
    margin-top: 14px;
}

.lobby-button {
    flex-grow: 1;
    width: 0;
    margin: 0;
}

.start-game-button {
    margin-left: 12px;
}
