.main-menu {
    flex-grow: 1;
    align-items: stretch;
    justify-content: flex-start;
}

.menu-content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.title-sign {
    padding: 10px 44px 12px 44px;
    margin-bottom: 44px;
    border-width: 4px;
    border-bottom-width: 9px;
    border-radius: 16px;
}

.game-title {
    font-size: 64px;
    padding: 0;
    margin: 0;
}

.menu-button {
    width: 280px;
    margin-bottom: 14px;
    font-size: 20px;
}

.language-label {
    color: rgb(29, 59, 92);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.language-options {
    flex-direction: row;
    height: 44px;
}

.language-button {
    width: 130px;
    height: 44px;
    margin: 0 5px;
    font-size: 16px;
}

.language-button:active:enabled {
    height: 40px;
}

.language-panel {
    position: relative;
    align-items: center;
    padding-bottom: 24px;
}

.room-dialog-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 30, 52, 0.7);
}

.room-dialog-blurred {
    filter: blur(5px);
}

.room-dialog-instance {
    width: 420px;
    max-width: 90%;
}

.room-dialog-hidden {
    display: none;
}
