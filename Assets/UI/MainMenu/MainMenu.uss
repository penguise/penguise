:root {
}

.main-menu {
    flex-grow: 1;
    align-items: stretch;
    justify-content: flex-start;
}

.menu-button {
    width: 240px;
    height: 48px;
    margin-top: 12px;
    font-size: 20px;
}

.game-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 24px;
}

.language-dropdown {
    width: 240px;
    font-size: 16px;
    flex-direction: column;
    align-items: stretch;
}

.language-panel {
    position: relative;
    align-items: center;
    padding-bottom: 24px;
}

.menu-content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}
