.room-dialog {
    flex-grow: 0;
    width: 100%;
    padding: 34px 22px 20px 22px;
}

.dialog-title {
    align-self: center;
    min-width: 60%;
    font-size: 24px;
    padding: 6px 22px 7px 22px;
    margin: 0 0 20px 0;
}

.room-input {
    font-size: 18px;
    flex-direction: column;
    align-items: stretch;
    margin: 0;
}

.dialog-status {
    font-size: 16px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 12px;
}

.dialog-status-success {
    color: rgb(30, 122, 52);
}

.dialog-status-error {
    color: rgb(190, 40, 40);
}

.room-dialog-hidden {
    display: none;
}

.dialog-actions {
    flex-direction: row;
    justify-content: center;
    height: 48px;
    margin-top: 22px;
}

.dialog-button {
    flex-grow: 1;
    width: 0;
    margin: 0 0 0 10px;
    font-size: 17px;
}

#cancel-button {
    margin-left: 0;
}
