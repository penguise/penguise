                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:c9ae84aa9c15cc347b5ddc0e6b4fd3be" entry="Id(256674643968)"/>
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="language-panel" class="language-panel">
            <ui:DropdownField name="language-dropdown" class="language-dropdown">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GUID:c9ae84aa9c15cc347b5ddc0e6b4fd3be" entry="Id(9107876626432)"/>
