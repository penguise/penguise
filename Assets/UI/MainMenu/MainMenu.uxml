<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="RoomDialog" src="project://database/Assets/UI/MainMenu/RoomDialog.uxml?fileID=9197481963319205126&amp;guid=871bf8ca72621b047b10b1b37f07bf51&amp;type=3#RoomDialog"/>
    <Style src="project://database/Assets/UI/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=26c1dbc2509d6a4498dd38ead07b6b9d&amp;type=3#MainMenu"/>
    <ui:VisualElement name="main-menu" class="main-menu">
        <ui:VisualElement name="menu-content" class="menu-content">
            <ui:Label text="Penguise" name="game-title" class="game-title"/>
            <ui:Button name="create-room-button" class="menu-button">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:c9ae84aa9c15cc347b5ddc0e6b4fd3be" entry="Id(174394982400)"/>
                </Bindings>
            </ui:Button>
            <ui:Button name="join-room-button" class="menu-button">
